#!/bin/bash
# Prepares the WordPress.org SVN working copy in ./svn: trunk and tags/<version>
# receive the production build of the plugin, and assets/ the icons of the
# plugin page from wporg-assets/. Nothing is sent: review the
# changes, then commit them yourself with the command printed at the end.

set -euo pipefail
cd -- "$(dirname "$0")/.."

svn_url='https://plugins.svn.wordpress.org/skuads-forms-for-elementor'
version="$(grep -m1 'Version:' skuads-elementor-forms/skuads-elementor-forms.php | grep -oE '[^ ]+$')"
stable_tag="$(grep -m1 'Stable tag:' skuads-elementor-forms/readme.txt | grep -oE '[^ ]+$')"

if [ "$version" != "$stable_tag" ]
then
    echo "Version ($version) and readme.txt Stable tag ($stable_tag) differ."
    exit 1
fi

if [ -d svn/.svn ]
then
    svn update --quiet svn
else
    rm -rf svn
    svn checkout --quiet "$svn_url" svn
fi

released=0
if svn ls "$svn_url/tags/$version" > /dev/null 2>&1
then
    released=1
fi

copy_plugin() {
    mkdir -p "$1"
    rsync -rc --delete \
        --exclude=.svn --exclude=.DS_Store \
        --exclude=/build --exclude=/vendor --exclude=/composer.lock \
        skuads-elementor-forms/ "$1/"
    cp settings/main.php "$1/includes/settings.php"
    cp LICENSE.md "$1/LICENSE.md"
}

if [ "$released" = 1 ]
then
    echo "Version $version is already released: only the directory assets are updated."
else
    copy_plugin svn/trunk
    copy_plugin "svn/tags/$version"
fi

# Icons and banners shown on the WordPress.org plugin page.
mkdir -p svn/assets
rsync -rc --delete --exclude=.svn --exclude=.DS_Store wporg-assets/ svn/assets/

cd svn
svn add --force --quiet trunk tags assets
for image in assets/*.png
do
    [ -e "$image" ] && svn propset --quiet svn:mime-type image/png "$image"
done
svn status | { grep '^!' || true; } | cut -c9- | while IFS= read -r missing
do
    svn delete --quiet "$missing"
done

svn status
echo
if [ -z "$(svn status)" ]
then
    echo "Nothing to send."
    exit 0
fi

message="Release $version"
[ "$released" = 1 ] && message='Update plugin directory assets'
echo "Ready. Send it with:"
echo "  svn commit $(pwd) --username skuads21 -m '$message'"
